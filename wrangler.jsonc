{
  "name": "meomum",
  "main": "worker.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meomum-db"
    }
  ]
}